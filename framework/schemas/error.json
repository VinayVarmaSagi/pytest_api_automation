{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "error.json",
  "title": "GoRest 422 Validation Error",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["field", "message"],
    "properties": {
      "field":   { "type": "string" },
      "message": { "type": "string" }
    },
    "additionalProperties": false
  }
}