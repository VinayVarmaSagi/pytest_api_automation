      "type": "string"
    },
    "gender": {
      "enum": [
        "male",
        "female"
      ],
      "title": "Gender",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "status": {
